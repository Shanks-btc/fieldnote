# Qloo (required) — server-side only, never expose to the client
QLOO_API_KEY=
# Optional override. Verified base URL for the hackathon: https://hackathon.api.qloo.com
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Spotify (required for album art + previews) — https://developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# LLM (creative-fit scoring + explanations). Set one; Anthropic wins if both are set.
# Optional: LLM_MODEL overrides the default (claude-haiku-5-5 / gpt-4o-mini).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000