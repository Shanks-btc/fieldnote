# Qloo (required) — server-side only, never expose to the client
QLOO_API_KEY=
# Optional override. Verified base URL for the hackathon: https://hackathon.api.qloo.com
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Spotify (required for album art + previews) — https://developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# LLM (required for brief parsing + explanations). Set one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
Qloo Hackathon API Server URL: https://hackathon.api.qloo.com
API Key: REDACTED
API Docs: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide